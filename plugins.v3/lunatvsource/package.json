{
  "name": "moviepilot-lunatvsource-plugin",
  "private": true,
  "version": "0.4.81",
  "type": "module",
  "scripts": {
    "build": "vite build && node --input-type=module -e \"import fs from 'node:fs';const p='dist/assets/remoteEntry.js';fs.writeFileSync(p,fs.readFileSync(p,'utf8').replace(/[ \\t]+$/gm,''))\""
  },
  "dependencies": {
    "vue": "^3.5.13",
    "vuetify": "3.7.3"
  },
  "devDependencies": {
    "@originjs/vite-plugin-federation": "^1.4.1",
    "@vitejs/plugin-vue": "^5.0.4",
    "vite": "^5.4.11"
  }
}
